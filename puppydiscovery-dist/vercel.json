{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/operations/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
